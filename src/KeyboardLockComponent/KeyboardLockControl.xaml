<UserControl x:Class="KeyboardCoolDownLock.KeyboardLockControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
    <Grid MaxWidth="820" Margin="0,0,24,36" HorizontalAlignment="Left">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <StackPanel>
        <TextBlock Text="键盘锁" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Margin="0,8,0,0" Text="临时停用键盘，让鼠标保持可用。适合给电脑散热或清洁键盘。" FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <ui:Card Grid.Row="1" Margin="0,28,0,0" Padding="24">
        <StackPanel>
          <TextBlock Text="锁定时长" FontSize="18" FontWeight="SemiBold" />
          <TextBlock Margin="0,4,0,0" Text="到时自动恢复，也可以随时用鼠标手动解锁。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <WrapPanel Margin="0,20,0,0">
            <Button Margin="0,0,8,8" Content="5 分钟" Tag="5" Click="Preset_Click" />
            <Button Margin="0,0,8,8" Content="15 分钟" Tag="15" Click="Preset_Click" />
            <Button Margin="0,0,8,8" Content="30 分钟" Tag="30" Click="Preset_Click" />
            <Button Margin="0,0,8,8" Content="60 分钟" Tag="60" Click="Preset_Click" />
          </WrapPanel>
          <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
            <ui:NumberBox x:Name="MinutesBox" Width="150" Minimum="1" Maximum="120" Value="15" SmallChange="1" AutomationProperties.Name="自动解锁时间（分钟）" />
            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Text="分钟" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <ui:Button Margin="0,24,0,0" Width="190" Height="46" HorizontalAlignment="Left" Appearance="Primary" Content="开始锁定" FontWeight="SemiBold" Click="Start_Click" AutomationProperties.Name="开始锁定键盘" />
          <ui:InfoBar x:Name="StatusBar" Margin="0,18,0,0" IsOpen="True" Severity="Informational" Title="当前未锁定" Message="键盘和鼠标均可正常使用。" />
        </StackPanel>
      </ui:Card>
      <ui:InfoBar Grid.Row="2" Margin="0,18,0,0" IsOpen="True" Severity="Informational" Title="始终留有安全退路" Message="锁定窗口保持可见，鼠标可点击“立即解锁”；超时自动恢复，Ctrl+Alt+Delete 不会被拦截。" />
    </Grid>
  </ScrollViewer>
</UserControl>
