<ui:FluentWindow x:Class="KeyboardCoolDownLock.LockWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="键盘已锁定 · 鼠标可用" Width="620" Height="420"
    MinWidth="620" MinHeight="420" ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen" WindowBackdropType="Mica"
    WindowCornerPreference="Round" ExtendsContentIntoTitleBar="True"
    Topmost="True" ShowInTaskbar="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="Yingqi Tools" ShowClose="False" />
    <Grid Grid.Row="1" Margin="48,28,48,42">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource AccentFillColorSecondaryBrush}" HorizontalAlignment="Left">
        <ui:SymbolIcon Symbol="Keyboard24" FontSize="28" />
      </Border>
      <TextBlock Grid.Row="1" Margin="0,20,0,0" Text="键盘已锁定" FontSize="30" FontWeight="SemiBold" />
      <TextBlock Grid.Row="2" Margin="0,8,0,0" Text="鼠标仍可正常使用。需要恢复时，请点击下方按钮。" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="15" />
      <StackPanel Grid.Row="3" Margin="0,28,0,0">
        <TextBlock x:Name="CountdownText" HorizontalAlignment="Center" FontSize="21" FontWeight="SemiBold" />
        <ProgressBar x:Name="CountdownProgress" Height="6" Margin="0,14,0,0" Maximum="1000" />
      </StackPanel>
      <Grid Grid.Row="5" Margin="0,28,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Height="52" Content="延长 5 分钟" Click="Extend_Click" />
        <ui:Button Grid.Column="2" Height="52" Appearance="Primary" Content="立即解锁键盘" FontSize="16" FontWeight="SemiBold" Click="Unlock_Click" AutomationProperties.Name="立即解锁键盘" />
      </Grid>
      <TextBlock Grid.Row="4" Margin="0,20,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Center" Text="安全兜底：Ctrl+Alt+Delete 不会被本工具拦截" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
    </Grid>
  </Grid>
</ui:FluentWindow>
